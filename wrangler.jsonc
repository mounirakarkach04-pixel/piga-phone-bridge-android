{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "piga-pocket-interface-mesh-preview",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/healthz", "/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_ENV": "preview",
    "SOURCE_COMMIT": "a79564a8f074000640e3309780bef410d0b10e76"
  }
}
